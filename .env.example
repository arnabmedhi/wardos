# Copy to .env (next to this file) and fill in. .env is git-ignored. Never commit real keys.

# --- Required for any AI step (reading photos, asks, the hospital robot's brain) ---
MODEL_API_KEY=                          # your Meta Model API key
# WARDOS_MUSE_BASE_URL=https://api.meta.ai/v1
# WARDOS_MUSE_MODEL=muse-spark-1.3-contributor
# WARDOS_MUSE_EFFORT=high

# --- Local run of the doctor screen (no Google sign-in) ---
WARDOS_DEV_DOCTOR=Test Doctor         # signs every visitor in as a test doctor. LOCAL ONLY: refused on Cloud Run
WARDOS_COOKIE_SECURE=false            # needed on http://localhost
# WARDOS_CHAIN_STORE=sqlite             # sqlite (local file) or firestore
# WARDOS_CHAIN_FILES=local              # local folder or drive
# WARDOS_PRIVATE_DIR=private            # runs, local record, sessions (git-ignored)

# --- Hosted mode (Cloud Run): Google sign-in, Firestore, Cloud Tasks, push alerts ---
# WARDOS_GOOGLE_CLIENT_ID=
# WARDOS_GOOGLE_CLIENT_SECRET=
# WARDOS_COOKIE_SECRET=                 # 40+ random characters
# WARDOS_PUBLIC_URL=https://your-service.example
# WARDOS_OWNER_EMAILS=you@example.com   # comma-separated admin e-mails (they can add doctors)
# WARDOS_MACHINE_ACCOUNTS=              # service-account e-mails allowed to call /internal routes
# WARDOS_CHAIN_PROJECT=your-gcp-project
# WARDOS_CHAIN_QUEUE=cloudtasks
# WARDOS_CHAIN_SERVICE_URL=
# WARDOS_CHAIN_RUNNER_SA=
# WARDOS_GOOGLE_CREDENTIALS=service-account.json
# WARDOS_VAPID_PUBLIC= / WARDOS_VAPID_PRIVATE= / WARDOS_VAPID_SUBJECT=mailto:you@example.com

# --- Discharge summary service (configured separately; without it the button says "summary service not configured") ---
# WARDOS_FINAL_JOB=                     # Cloud Run Job that writes the summary document
# WARDOS_FINAL_REGION=asia-south1
# WARDOS_FINAL_TESTS_FOLDER_ID=         # Drive folder for the job's input
# WARDOS_FINAL_RECORDS_FOLDER_ID=       # Drive folder for the finished documents
# WARDOS_CHAIN_DRIVE_TOKEN=token.json

# --- Hospital robot ---
# WARDOS_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
# WARDOS_OPENMRS_URL=https://your-openmrs-host.example
# OPENMRS_USERNAME=admin
# OPENMRS_PASSWORD=
# WARDOS_PORTAL_SECRETS=.env            # file holding LIS_USERNAME / LIS_PASSWORD for a real hospital portal
# WARDOS_OTP_CONFIG=private/otp.env     # WARDOS_OTP_EMAIL / WARDOS_OTP_APP_PASSWORD (IMAP inbox for the portal OTP)
# WARDOS_OTP_SOURCE=private/otp-source.json
